<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="com.distcache" level="INFO" />
    <logger name="com.distcache.cluster.ConsistentHashRouter" level="WARN" />
    <logger name="com.distcache.cluster.ArrayBinarySearchRouter" level="WARN" />
    <logger name="io.netty" level="WARN" />
</configuration>
